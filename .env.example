# --- Postgres (consumed by both the db service and the api) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=projects
# Host is the compose service name, not localhost.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/projects

# --- Auth ---
JWT_SECRET=change-me-in-the-sandbox
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- S3 ---
S3_BUCKET=project-documents
AWS_REGION=us-east-1
# Point at LocalStack for local dev; leave empty to use real AWS.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Limits ---
MAX_PROJECT_BYTES=104857600
